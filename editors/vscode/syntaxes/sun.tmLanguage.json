{
  "scopeName": "source.sun",
  "patterns": [
    {
      "name": "comment.line.number-sign.sun",
      "match": "#.*$"
    },
    {
      "name": "meta.inline.cpp.sun",
      "begin": "^\\s*(inline\\s+cpp:)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.inline-cpp.sun"
        }
      },
      "end": "^\\s*(endcpp)\\s*$",
      "endCaptures": {
        "1": {
          "name": "keyword.other.inline-cpp.sun"
        }
      },
      "patterns": [
        {
          "include": "source.cpp"
        }
      ]
    },
    {
      "name": "string.quoted.double.fstring.sun",
      "begin": "f\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.sun"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.sun"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.sun",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.sun",
          "begin": "\\{(?=[^{}]*\\})",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.sun"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.sun"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "string.quoted.double.sun",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.sun"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.sun"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.sun",
              "match": "\\\\."
            },
            {
              "name": "constant.character.format-placeholder.sun",
              "match": "%v|%%"
            }
          ]
        },
        {
          "name": "constant.character.format-placeholder.sun",
          "match": "%v|%%"
        }
      ]
    },
    {
      "name": "constant.numeric.sun",
      "match": "\\b(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?\\b"
    },
    {
      "name": "constant.language.boolean.sun",
      "match": "\\b(?:true|false)\\b"
    },
    {
      "name": "constant.language.null.sun",
      "match": "\\b(?:NaN|nan)\\b"
    },
    {
      "name": "storage.type.sun",
      "match": "\\b(?:string|str|number|int|bool|char|region|ptr|bytes|json|list|dict|tuple)\\b"
    },
    {
      "name": "support.module.sun",
      "match": "\\b(?:math|io|sys|memory|json|bytes)\\b(?=\\.)"
    },
    {
      "name": "support.function.builtin.sun",
      "match": "\\b(?:print|printc|input|len|sum|all|any|min|max|round|abs|floor|ceil|trunc|int|number|char|istype|assert|range|open|read|write|close|pw)\\b(?=\\s*\\()"
    },
    {
      "name": "support.function.math.sun",
      "match": "(?<=math\\.)(?:abs|acos|asin|atan|atan2|ceil|cos|exp|floor|fmod|hypot|log|log10|log2|pow|sin|sqrt|tan|trunc)\\b"
    },
    {
      "name": "support.function.module.sun",
      "match": "(?<=io\\.)(?:open|read|write|close|pw|write_text|append_text|write_bytes|read_text|read_bytes|exists|read_lines|is_directory|remove|create_directories|createdir|file_size)\\b|(?<=memory\\.)(?:alloc|alloc_ptr|size|read_u8|read_u16|read_u32|write_u8|write_u16|write_u32|fill|copy|free_ptr|ptr_size|ptr_is_null)\\b|(?<=json\\.)(?:loads|dumps)\\b|(?<=bytes\\.)(?:from_string|to_string|from_list|to_list|from_region|to_region)\\b|(?<=sys\\.)(?:args|platform|cwd|env|env_exists|exit)\\b"
    },
    {
      "name": "support.function.method.sun",
      "match": "(?<=\\.)(?:upper|lower|trim|split|replace|contains|starts_with|ends_with|append|insert|remove|pop|clear|keys|values|get|as_string|as_number|as_int|as_bool|is_null|size)\\b(?=\\s*\\()"
    },
    {
      "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.sun"
        },
        "2": {
          "name": "entity.name.function.sun"
        }
      }
    },
    {
      "match": "\\b(class|struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.sun"
        },
        "2": {
          "name": "entity.name.type.sun"
        }
      }
    },
    {
      "name": "keyword.control.sun",
      "match": "\\b(?:def|class|struct|enum|if|elif|else|while|for|in|match|case|try|with|catch|except|finally|export|let|const|raise|return|break|continue|import|end|and|or|not)\\b"
    },
    {
      "name": "keyword.other.sun",
      "match": "\\b(?:as|AnError|cppCatcher)\\b"
    },
    {
      "name": "variable.parameter.sun",
      "match": "(?<=\\*\\*)[A-Za-z_][A-Za-z0-9_]*|(?<=\\*)[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "keyword.operator.sun",
      "match": "\\*\\*|==|!=|<=|>=|\\+|-|\\*|/|%|=|<|>|:"
    },
    {
      "name": "entity.name.function.call.sun",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    }
  ]
}
